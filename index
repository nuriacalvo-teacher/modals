  <title>English Grammar Academy | Modal Verbs · 9 modules · 3 levels</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .gradient-bg { background: linear-gradient(135deg, #090d16 0%, #111827 50%, #14532d 100%); }
    .neon-border { box-shadow: 0 0 15px rgba(16, 185, 129, 0.15); }
    .neon-border:hover { box-shadow: 0 0 25px rgba(52, 211, 153, 0.45); }

    .gap-input {
      background: #020617;
      border: none;
      border-bottom: 3px solid #475569;
      color: #fff;
      font-weight: 800;
      text-align: center;
      padding: 2px 10px;
      margin: 0 4px 6px;
      border-radius: 6px 6px 0 0;
      outline: none;
      transition: all .15s ease;
      display: inline-block;
      min-width: 7ch;
      max-width: 100%;
    }
    .gap-input:focus { border-bottom-color: #34d399; background: #0b1220; }
    .gap-input.wide { display: block; width: 100%; min-width: 0; text-align: left; border: 2px solid #334155; border-radius: 14px; padding: 12px 16px; margin: 0; }
    .gap-input.wide:focus { border-color: #34d399; }
    .gap-input.wide::placeholder { color: #475569; font-weight: 600; }
    .mcq-opt:disabled { cursor: default; }
    .mcq-ok { border-color: #10b981 !important; background: rgba(6,78,59,.55) !important; color: #6ee7b7 !important; }
    .mcq-ko { border-color: #f43f5e !important; background: rgba(76,5,25,.55) !important; color: #fda4af !important; }
    .gap-ok { border-bottom-color: #10b981 !important; color: #6ee7b7 !important; background: rgba(6,78,59,.45) !important; }
    .gap-ko { border-bottom-color: #f43f5e !important; color: #fda4af !important; background: rgba(76,5,25,.45) !important; }

    @media print {
      .no-print { display: none !important; }
      body { background: white !important; color: black !important; }
      .print-card { border: 2px solid #000 !important; background: #fff !important; color: #000 !important; }
    }
  </style>

<!-- 1. Firebase libraries -->
