      /* ---------- 3. contracciones ---------- */
      const NEG_BASE = { do: "do", does: "does", did: "did", is: "is", are: "are", was: "was", were: "were",
        have: "have", has: "has", had: "had", could: "could", should: "should", would: "would", must: "must",
