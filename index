    function handleRegistration(e) {
      e.preventDefault();
      if (guestUI) { enterGuestMode(); return; }
      if (!currentAuthUser) { showAuthError("\u26a0\ufe0f Sign in with Google first."); return; }
      if (!isSchoolAccount(currentAuthUser.email)) {
        showCodeError("\u26a0\ufe0f This app only saves the work of @" + window.SCHOOL_DOMAIN +
                      " accounts. You can still practise with the button below.");
        return;
      }
      const code = normalizeCode(document.getElementById("regClassCode").value);
      if (!code) { showCodeError("\u26a0\ufe0f Write your class code."); return; }

      const user = readRegistrationForm();
      user.guest = false;
      user.classCode = code;

      const btn = e.target.querySelector("button[type=submit]");
      if (btn) { btn.disabled = true; btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Checking...`; }
      showCodeError("");

      // Solo Firebase sabe que codigos valen: si el codigo es bueno, el perfil
      // se guarda; si no, la propia base de datos rechaza la escritura.
      currentUser = user;
      saveMyProfile(true).then(() => {
        if (btn) { btn.disabled = false; btn.innerHTML = `Enter the Academy <i class="fa-solid fa-arrow-right"></i>`; }
        startSession(user);
        fetchMyRecords(() => renderModules());
      }).catch(err => {
        currentUser = null;
        if (btn) { btn.disabled = false; btn.innerHTML = `Enter the Academy <i class="fa-solid fa-arrow-right"></i>`; }
        const permiso = err && (err.code === "PERMISSION_DENIED" || /permission/i.test(err.message || ""));
        showCodeError(permiso
          ? "\u26a0\ufe0f Wrong class code. Ask your own teacher for it" +
            (window.ALLOW_GUEST_MODE ? ", or use the button below to practise without saving." : ".")
          : "\u26a0\ufe0f Could not connect (" + ((err && err.message) || "error") + "). Check your connection.");
        document.getElementById("regClassCode").focus();
      });
    }

