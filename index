      // Mueve cada hueco {T:} al principio y/o al final de SU oración (las oraciones se separan con ;)
      const SLOT_RX = new RegExp(OPEN + "([^" + SEP + "]*)" + SEP + "[^" + CLOSE + "]*" + CLOSE, "g");
      function placeSlots(str) {
