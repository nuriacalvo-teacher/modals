    /* ---------- progress saved in the browser (so a closed tab is not lost) ---------- */
    function saveProgress() {
      const mod = currentModule();
      storageSet(progressKey(mod.id), JSON.stringify({
        order: currentQuestions.map(q => q.qid),
        idx: currentQuestionIdx + (answered ? 1 : 0),
        score: currentScore,
        seconds: quizSeconds,
        log: attemptLog,
        retry: retryState
      }));
    }

    function startCurrentQuiz(forceNew) {
      const mod = currentModule();
      const saved = forceNew ? null : storageGet(progressKey(mod.id));
      let resumed = false;
      if (saved) {
        try {
          const p = JSON.parse(saved);
          const n = (p.order || []).length || mod.size;
          if (p.idx > 0 && p.idx < n &&
              confirm(`You have an unfinished attempt (${p.idx} of ${n} questions done).\n\nOK = continue where you stopped\nCancel = start again from the beginning`)) {
            currentQuestions = p.order.map(id => mod.questions.find(q => q.qid === id)).filter(Boolean);
            currentQuestionIdx = p.idx;
            currentScore = p.score;
            quizSeconds = p.seconds || 0;
            attemptLog = p.log || [];
            retryState = p.retry || null;
            resumed = currentQuestions.length === (retryState ? n : mod.size);
          }
        } catch (e) {}
      }
      if (!resumed) {
        retryState = null;
        storageDel(progressKey(mod.id));
        currentQuestions = shuffle(mod.questions).slice(0, mod.size);
        currentQuestionIdx = 0;
        currentScore = 0;
        quizSeconds = 0;
        attemptLog = [];
      }
      if (mod.type === "translate") setTimeout(() => L3.prepareModule(mod), 50);   // L3-ENGINE: prepara las variantes en segundo plano
      document.getElementById("quizCategoryTitle").innerText = mod.title + (retryState ? " \u00b7 \ud83c\udfaf Only your mistakes" : "");
      showView("viewQuiz");
      window.scrollTo(0, 0);
      startTimer();
      renderQuestion();
    }

    /* ===== RETRY-WRONG v1 · START (igual en todas las apps) =====
       Si el alumno no aprueba, puede repetir SOLO las preguntas que ha fallado.
       Las acertadas se conservan y la nota se calcula siempre sobre el módulo entero. */
    function wrongQuestionsOf(mod, log) {
      return log.filter(a => !a.ok)
        .map(a => mod.questions.find(q => q.qid === a.qid || (!a.qid && questionPromptText(q) === a.prompt)))
        .filter(Boolean);
    }
    function startRetryWrong() {
      const mod = currentModule();
      const qs = wrongQuestionsOf(mod, attemptLog);   // attemptLog = registro completo del intento que acaba de terminar
      if (!qs.length) { startCurrentQuiz(true); return; }
      retryState = { round: (retryState ? retryState.round : 1) + 1, carried: attemptLog.filter(a => a.ok) };
      storageDel(progressKey(mod.id));
      currentQuestions = shuffle(qs);
      currentQuestionIdx = 0;
      currentScore = 0;
      attemptLog = [];                                 // quizSeconds sigue sumando: el tiempo es el de todo el intento
      if (mod.type === "translate" && typeof L3 !== "undefined") setTimeout(() => L3.prepareModule(mod), 50);
      document.getElementById("quizCategoryTitle").innerText = mod.title + " \u00b7 \ud83c\udfaf Only your mistakes";
      showView("viewQuiz");
      window.scrollTo(0, 0);
      startTimer();
      renderQuestion();
    }
    /* ===== RETRY-WRONG v1 · END ===== */

    function startTimer() {
      if (quizTimerInterval) clearInterval(quizTimerInterval);
      const paint = () => {
        const mins = String(Math.floor(quizSeconds / 60)).padStart(2, "0");
        const secs = String(quizSeconds % 60).padStart(2, "0");
        document.getElementById("quizTimer").innerText = `${mins}:${secs}`;
      };
      paint();
      quizTimerInterval = setInterval(() => { quizSeconds++; paint(); }, 1000);
    }

    function renderQuestion() {
      answered = false;
      const q = currentQuestions[currentQuestionIdx];
      const total = currentQuestions.length;

      document.getElementById("quizQuestionCount").innerText = `Question ${currentQuestionIdx + 1} of ${total}`;
      document.getElementById("quizProgressBar").style.width = `${((currentQuestionIdx + 1) / total) * 100}%`;

      const t = TYPES[q.type];
      document.getElementById("quizTypeBadge").innerHTML = `
        <div class="flex flex-wrap justify-between items-center gap-3">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border ${t.badge} text-sm md:text-base font-black uppercase tracking-wider">
            <i class="fa-solid ${q.mode === "join" ? "fa-shuffle" : t.icon}"></i> ${q.mode === "join" ? "Rephrasing" : t.label}
          </span>
          <span class="text-sm md:text-base font-black text-emerald-400">\u2714 ${currentScore} / ${currentQuestionIdx} correct</span>
        </div>`;

      document.getElementById("quizSentence").innerHTML = questionBodyHtml(q);

      const hintZone = document.getElementById("verbFormsHint");
      if (q.type === "translate" && q.mode !== "join") {
        const words = vocabHints(q.prompt, 7);
        if (words.length) {
          hintZone.innerHTML = `
            <button type="button" onclick="toggleQuizHint()" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 font-black px-5 py-3 rounded-2xl transition text-base">
              \ud83d\udca1 Vocabulary
            </button>
            <div id="hintBox" class="hidden mt-3 bg-amber-950/30 border-2 border-amber-500/40 rounded-2xl p-4 space-y-1">
              ${words.map(w => `<p class="text-base md:text-lg text-amber-200"><strong lang="es">${escapeHtml(w.es)}</strong> = ${escapeHtml(w.en)}</p>`).join("")}
            </div>`;
          hintZone.classList.remove("hidden");
        } else {
          hintZone.innerHTML = "";
          hintZone.classList.add("hidden");
        }
      } else {
        hintZone.innerHTML = "";
        hintZone.classList.add("hidden");
      }

      document.getElementById("quizFeedback").classList.add("hidden");
      document.getElementById("nextQuestionBtn").classList.add("hidden");
      const checkBtn = document.getElementById("checkAnswerBtn");
      checkBtn.classList.remove("hidden");
      checkBtn.disabled = (q.type === "mcq");

      const inputs = questionInputs();
      inputs.forEach((input, i) => {
        input.addEventListener("keydown", (ev) => {
          if (ev.key !== "Enter") return;
          ev.preventDefault();
          if (answered) { nextQuestion(); return; }
          if (i < inputs.length - 1) inputs[i + 1].focus(); else checkExercise();
        });
      });
      if (inputs[0]) inputs[0].focus();
    }

    function checkExercise() {
      if (answered) return;
      const q = currentQuestions[currentQuestionIdx];
      const isMcq = q.type === "mcq";
      const inputs = questionInputs();
      const hidden = document.getElementById("ans_0");
      const values = isMcq ? [(hidden && hidden.value) || ""] : inputs.map(i => i.value.trim());
      if (values.every(v => !v)) {
        if (isMcq) return;
        if (inputs[0]) { inputs[0].focus(); inputs[0].placeholder = "?"; }
        return;
      }

      let ok = false, parts = null;
      if (isMcq) ok = gradeMcq(values[0], q);
      else if (q.type === "gap") { const r = gradeGapValues(values, q); ok = r.ok; parts = r.partes; }
      else ok = gradeTranslation(values[0], q);

      if (isMcq) {
        document.querySelectorAll(".mcq-opt").forEach(b => {
          b.disabled = true;
          const esta = normalize(b.dataset.value);
          if (esta === normalize(q.answers[0])) b.classList.add("mcq-ok");
          else if (esta === normalize(values[0])) b.classList.add("mcq-ko");
          else b.classList.add("opacity-50");
        });
      } else {
        inputs.forEach((input, i) => {
          input.readOnly = true;
          input.classList.add((parts ? parts[i] : ok) ? "gap-ok" : "gap-ko");
        });
      }
      answered = true;
      if (ok) currentScore++;

      attemptLog.push({
        qid: q.qid, type: q.type, prompt: questionPromptText(q), user: values.join(" \u00b7 "),
        correct: modelAnswer(q), ok: ok
      });
      saveProgress();

      let detail = "";
      if (q.type === "gap") {
        detail = `<div class="mt-3 text-base md:text-xl text-slate-200 font-semibold">${escapeHtml(mayuscula(fillGaps(q.text, modelGapValues(q))))}</div>`;
      } else if (isMcq) {
        detail = `<div class="mt-3 text-base md:text-xl text-slate-200 font-semibold">${escapeHtml(gapCount(q.text) ? mayuscula(fillGaps(q.text, (q.answers[0] || "").split(" / "))) : (q.answers[0] || ""))}</div>`;
      } else if (q.type === "translate") {
        const otras = q.answers.slice(1, 3);
        detail = otras.length
          ? `<div class="mt-3 text-base md:text-lg text-slate-300 font-semibold">Also accepted: ${otras.map(a => `<span class="font-mono text-emerald-200">${escapeHtml(a)}</span>`).join(" \u00b7 ")}</div>`
          : "";
      }
      if (q.x) {
        detail += `<div class="mt-3 text-base md:text-lg text-slate-300 font-semibold border-t border-slate-700/60 pt-3">
          <i class="fa-solid fa-lightbulb text-amber-400"></i> ${q.x}</div>`;
      }

      const feedbackBox = document.getElementById("quizFeedback");
      if (ok) {
        feedbackBox.className = "p-6 md:p-8 rounded-2xl text-lg md:text-2xl font-bold border-2 bg-emerald-950/40 border-emerald-500/60 text-emerald-200";
        feedbackBox.innerHTML = `<strong>CORRECT! \ud83c\udf89</strong>${detail}`;
      } else {
        feedbackBox.className = "p-6 md:p-8 rounded-2xl text-lg md:text-2xl font-bold border-2 bg-rose-950/40 border-rose-500/60 text-rose-200";
        const solucion = (q.type === "gap")
          ? modelGapValues(q).join("  +  ")
          : q.answers[0];
        feedbackBox.innerHTML = `<div class="mb-2"><strong>SOLUTION:</strong> <span class="text-emerald-300 font-mono">${escapeHtml(solucion)}</span></div>${detail}`;
      }
      feedbackBox.classList.remove("hidden");
      document.getElementById("checkAnswerBtn").classList.add("hidden");
      const nextBtn = document.getElementById("nextQuestionBtn");
      nextBtn.classList.remove("hidden");
      nextBtn.innerHTML = (currentQuestionIdx < currentQuestions.length - 1)
        ? `Next question <i class="fa-solid fa-arrow-right ml-2"></i>`
        : `See result <i class="fa-solid fa-flag-checkered ml-2"></i>`;
      nextBtn.focus();
    }

    function nextQuestion() {
      if (currentQuestionIdx < currentQuestions.length - 1) {
        currentQuestionIdx++;
        renderQuestion();
      } else {
        finishQuiz();
      }
    }

    function quitQuiz() {
      if (confirm("Leave this module now? Your progress is saved on this device and you can continue later.")) {
        clearInterval(quizTimerInterval);
        goHome();
      }
    }

    function finishQuiz() {
      clearInterval(quizTimerInterval);
      const mod = currentModule();
      storageDel(progressKey(mod.id));
      if (retryState) attemptLog = retryState.carried.concat(attemptLog);   // RETRY-WRONG: módulo completo
      const retryRound = retryState ? retryState.round : 1;
      const total = attemptLog.length;
      currentScore = attemptLog.filter(a => a.ok).length;
      const percentage = Math.round((currentScore / total) * 100);
      const timeStr = `${Math.floor(quizSeconds / 60)}m ${quizSeconds % 60}s`;
      const nowStr = new Date().toLocaleString("en-GB", { dateStyle: "short", timeStyle: "short" });
      const passed = percentage >= passMark(mod);

      const record = {
        studentName: fullName(),
        firstName: currentUser.firstName,
        lastName: currentUser.lastName,
        email: currentUser.email,
        grade: currentUser.grade,
        group: currentUser.grade,
        classCode: currentUser.guest ? "" : currentUser.classCode,
        guest: !!currentUser.guest,
        topic: mod.title,
        moduleId: mod.id,
        exerciseType: "modal_verbs_levels",
        score: percentage,
        rawScore: `${currentScore}/${total}`,
        retryRound: retryRound,
        passed: passed,
        secondsSpent: quizSeconds,
        timeSpent: timeStr,
        dateTime: nowStr,
        timestamp: Date.now(),
        answers: attemptLog.map(a => ({ prompt: a.prompt, type: a.type, user: a.user, correct: a.correct, ok: a.ok }))
      };

      const message = passed
        ? `
          <div class="bg-emerald-950/50 border-2 border-emerald-400/60 rounded-2xl p-5 md:p-6 text-center space-y-3">
            <h3 class="text-2xl md:text-3xl font-black text-emerald-300">🎉 CONGRATULATIONS, ${escapeHtml(currentUser.firstName.toUpperCase())}!</h3>
            <p class="text-slate-100 text-base md:text-xl">You have passed <strong>${mod.title}</strong>${retryRound > 1 ? ` after repeating your mistakes (round ${retryRound})` : ""}. Well done!</p>
            <div class="bg-amber-400/15 border-2 border-amber-400/60 rounded-xl p-4 text-amber-200 text-base md:text-xl font-bold">
              <i class="fa-solid fa-camera"></i> Now take a <strong>SCREENSHOT</strong> of this result and send it to your teacher through <strong>Google Classroom</strong>.
            </div>
          </div>`
        : `
          <div class="bg-rose-950/40 border-2 border-rose-500/50 rounded-2xl p-5 md:p-6 text-left space-y-2">
            <p class="text-rose-200 text-lg md:text-xl font-black"><i class="fa-solid fa-rotate-right"></i> You have to try again!</p>
            <p class="text-slate-200 text-base md:text-lg">You got <strong>${currentScore} out of ${total}</strong>${retryRound > 1 ? ` (round ${retryRound})` : ""}. You need <strong class="text-amber-300">at least ${passMark(mod)}% (${Math.ceil(total * passMark(mod) / 100)} out of ${total})</strong> to pass.
            Remember: <strong>for your work to count, you must pass every level of every module</strong>.</p>
            <p class="text-amber-200 text-base md:text-lg font-bold">🎯 You do not need to start again: you can repeat <strong>only the ${total - currentScore} question${total - currentScore === 1 ? "" : "s"} you got wrong</strong>. The ones you got right are kept.</p>
            <p class="text-slate-300 text-base md:text-lg">Read the theory again, look at your mistakes below and have another go. You can do it! 💪
            When you pass, take a screenshot of your result and send it to your teacher through Google Classroom.</p>
          </div>`;

      document.getElementById("resultsCard").innerHTML = `
        ${studentStrip()}
        <div class="w-24 h-24 mx-auto rounded-full flex items-center justify-center text-4xl font-black ${passed ? "bg-emerald-500/20 text-emerald-400 border-2 border-emerald-500/50" : "bg-rose-500/20 text-rose-400 border-2 border-rose-500/50"}">
          ${percentage}%
        </div>
        ${message}
        <div class="bg-slate-950 p-6 rounded-2xl border-2 border-slate-800 text-left text-base md:text-xl text-slate-200 space-y-3 max-w-lg mx-auto">
          <div class="flex justify-between gap-3"><span class="text-slate-400">Name:</span> <span class="font-bold text-white text-right">${escapeHtml(currentUser.firstName)}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Surname(s):</span> <span class="font-bold text-white text-right">${escapeHtml(currentUser.lastName)}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Group:</span> <span class="font-bold text-emerald-300">${escapeHtml(currentUser.grade)}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Exercise:</span> <span class="font-bold text-emerald-400 text-right">${mod.title}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Score:</span> <span class="font-bold text-white">${record.rawScore} (${percentage}%)</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Result:</span> <span class="font-bold ${passed ? "text-emerald-400" : "text-rose-400"} text-right">${passed ? "✅ Passed" : "⚠️ Not passed (minimum " + passMark(mod) + "%)"}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Time:</span> <span class="font-bold text-emerald-400">${timeStr}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Class code:</span> <span class="font-bold text-amber-400">${currentUser.guest ? "— (guest · not saved)" : escapeHtml(currentUser.classCode)}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400">Date:</span> <span class="font-bold text-white">${nowStr}</span></div>
        </div>
        <div id="saveStatusLine" class="text-xs font-bold text-slate-500 flex items-center justify-center gap-2">
          <i class="fa-solid fa-cloud-arrow-up"></i> Saving to the cloud...
        </div>
        <div class="pt-4 flex flex-col md:flex-row gap-3 justify-center no-print">
          ${!passed && total - currentScore > 0 ? `<button onclick="startRetryWrong()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-lg px-8 py-4 rounded-2xl transition order-first">🎯 Repeat only the ${total - currentScore} I got wrong</button>` : ""}
          ${!passed ? `<button onclick="startCurrentQuiz(true)" class="bg-rose-600 hover:bg-rose-500 text-white font-black text-lg px-8 py-4 rounded-2xl transition">🔁 Try the whole module again</button>` : ""}
          <button onclick="goHome()" class="${passed ? "bg-emerald-600 hover:bg-emerald-500" : "bg-slate-800 hover:bg-slate-700"} text-white font-black text-lg px-8 py-4 rounded-2xl transition">Back to Dashboard</button>
        </div>`;

      renderReview();
      showView("viewResults");
      window.scrollTo(0, 0);
      saveResultToFirebase(record);
    }

    function renderReview() {
      const wrong = attemptLog.filter(a => !a.ok).length;
      const rows = attemptLog.map((a, idx) => {
        const t = TYPES[a.type] || TYPES.gap;
        return `
          <div class="bg-slate-950 border ${a.ok ? "border-emerald-500/30" : "border-rose-500/50"} rounded-2xl p-3 md:p-4 text-left">
            <div class="flex justify-between items-start gap-3 mb-1">
              <span class="text-sm font-black ${a.ok ? "text-emerald-400" : "text-rose-400"}"><i class="fa-solid ${a.ok ? "fa-circle-check" : "fa-circle-xmark"}"></i> ${idx + 1}</span>
              <span class="text-[11px] font-black uppercase px-2 py-1 rounded-lg border ${t.badge}">${t.label}</span>
            </div>
            <p class="text-base md:text-lg text-slate-200 font-semibold">${escapeHtml(a.prompt)}</p>
            <p class="text-sm md:text-base mt-1"><span class="text-slate-500">You wrote:</span> <span class="${a.ok ? "text-emerald-300" : "text-rose-300"} font-mono">${escapeHtml(a.user) || "\u2014"}</span></p>
            ${a.ok ? "" : `<p class="text-sm md:text-base"><span class="text-slate-500">Correct:</span> <span class="text-emerald-300 font-mono">${escapeHtml(a.correct)}</span></p>`}
          </div>`;
      }).join("");
      document.getElementById("reviewCard").innerHTML = `
        <p class="text-sm md:text-base font-bold text-slate-300 border-b border-slate-800 pb-3 mb-3">
          <i class="fa-solid fa-user text-emerald-400 mr-1"></i> ${escapeHtml(currentUser.firstName)} <span class="text-emerald-300">${escapeHtml(currentUser.lastName)}</span>
          <span class="text-slate-500">\u00b7</span> <span class="text-amber-300">Group: ${escapeHtml(currentUser.grade)}</span>
        </p>
        <div class="flex justify-between items-center mb-2 gap-3">
          <h3 class="text-xl md:text-2xl font-black text-white"><i class="fa-solid fa-list-check text-emerald-400 mr-2"></i>Correction (${wrong} mistake${wrong === 1 ? "" : "s"})</h3>
          <button onclick="window.print()" class="no-print text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold px-4 py-2 rounded-xl"><i class="fa-solid fa-print"></i> Print</button>
        </div>
        <div class="grid grid-cols-1 gap-2">${rows}</div>`;
    }

    function saveResultToFirebase(record, isRetry) {
      if (!isRetry) saveResultLocally(record);

      if (currentUser.guest || !currentUser.uid) {
        const line = document.getElementById("saveStatusLine");
        if (line) line.innerHTML = `<i class="fa-solid fa-user-clock text-slate-400"></i> <span class="text-slate-400">Guest mode: this result is only on this device, it is not sent to any teacher.</span>`;
        return;
      }

      myAttemptsRef().push(record).then(() => {
        const line = document.getElementById("saveStatusLine");
        if (line) line.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i> <span class="text-emerald-400">Saved to the cloud</span>`;
      }).catch(err => {
        console.error("Error saving to Firebase:", err);
        if (!isRetry) {
          setTimeout(() => saveResultToFirebase(record, true), 2500);
        } else {
          const line = document.getElementById("saveStatusLine");
          if (line) line.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-400"></i> <span class="text-amber-400">Could not save. Please tell your teacher.</span>`;
        }
      });
    }

    /* ============================================================
       FINAL REPORT
       ============================================================ */
    function showGlobalReportModal() {
      showView("viewGlobalReport");
      window.scrollTo(0, 0);
      const container = document.getElementById("globalReportDetails");
      container.innerHTML = `<div class="text-center py-10 text-slate-400 font-bold"><i class="fa-solid fa-spinner fa-spin text-2xl mb-3"></i><br>Loading your report...</div>`;

      fetchMyRecords((records) => {
        let completedCount = 0, passedCount = 0, sum = 0, secondsSum = 0;
        let breakdownHtml = "";
        LEVELS.forEach(lv => {
          const mine = modulesOfLevel(lv.n);
          const donos = mine.filter(m => records.some(r => r && r.moduleId === m.id)).length;
          breakdownHtml += `<div class="md:col-span-2 mt-2 flex items-center justify-between gap-3">
              <span class="text-sm font-black px-3 py-1 rounded-xl border ${lv.chip}">${lv.name}</span>
              <span class="text-xs font-bold text-slate-500">${donos} / ${mine.length} done</span>
            </div>`;
          mine.forEach(mod => {
          const list = records.filter(r => r && r.moduleId === mod.id);
          if (list.length) {
            const best = list.reduce((max, r) => (Number(r.score) > Number(max.score) ? r : max), list[0]);
            const ok = Number(best.score) >= passMark(mod);
            completedCount++; if (ok) passedCount++;
            sum += Number(best.score) || 0; secondsSum += best.secondsSpent || 0;
            breakdownHtml += `
              <div class="flex justify-between items-center bg-slate-950/80 p-4 rounded-xl border ${ok ? "border-emerald-500/40" : "border-rose-500/50"} text-sm md:text-base">
                <span class="font-extrabold text-white">${mod.moduleTitle}</span>
                <div class="text-right">
                  <span class="font-black ${ok ? "text-emerald-400" : "text-rose-400"}">${ok ? "✅" : "❌"} ${best.score}%</span>
                  <span class="text-slate-500 text-xs ml-2">(${best.rawScore || ""} · ${list.length} attempt${list.length > 1 ? "s" : ""})</span>
                </div>
              </div>`;
          } else {
            breakdownHtml += `
              <div class="flex justify-between items-center bg-slate-950/30 p-4 rounded-xl border border-slate-800/40 text-sm opacity-60">
                <span class="font-bold text-slate-400">${mod.moduleTitle}</span>
                <span class="text-rose-400 font-bold italic">Pending</span>
              </div>`;
          }
          });
        });

        if (completedCount < MODULES.length) {
          container.innerHTML = `
            ${studentStrip()}
            <div class="text-center py-4 space-y-4">
              <div class="w-16 h-16 mx-auto rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-3xl border-2 border-amber-500/40"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <h3 class="text-2xl font-black text-white">Incomplete</h3>
              <p class="text-slate-300 text-base md:text-lg max-w-md mx-auto">You have done <strong>${completedCount} of ${MODULES.length}</strong> levels (${MODULE_DEFS.length} modules \u00d7 ${LEVELS.length} levels). Pass them all to master modal verbs.</p>
              <div class="space-y-2 text-left my-4">${breakdownHtml}</div>
              <button onclick="goHome()" class="no-print bg-emerald-600 text-white font-extrabold px-8 py-4 rounded-2xl text-base">Go back and continue</button>
            </div>`;
          return;
        }

        const allPassed = passedCount === MODULES.length;
        const avg = Math.round(sum / MODULES.length);
        const nowStr = new Date().toLocaleString("en-GB", { dateStyle: "short", timeStyle: "short" });
        const msg = allPassed
          ? `<div class="bg-emerald-950/50 border-2 border-emerald-400/60 rounded-2xl p-5 md:p-6 text-center space-y-3">
               <div class="text-5xl">🏆🎉</div>
               <h3 class="text-2xl md:text-3xl font-black text-emerald-300">CONGRATULATIONS, ${escapeHtml(currentUser.firstName.toUpperCase())}!</h3>
               <p class="text-slate-100 text-base md:text-xl">You have passed <strong>all ${MODULES.length} levels</strong>: you have mastered modal verbs!</p>
               <div class="bg-amber-400/15 border-2 border-amber-400/60 rounded-xl p-4 text-amber-200 text-base md:text-xl font-bold"><i class="fa-solid fa-camera"></i> Take a <strong>SCREENSHOT</strong> of this final result and send it to your teacher through <strong>Google Classroom</strong>.</div>
             </div>`
          : `<div class="bg-rose-950/40 border-2 border-rose-500/50 rounded-2xl p-5 md:p-6 text-left space-y-2">
               <p class="text-rose-200 text-lg md:text-xl font-black"><i class="fa-solid fa-rotate-right"></i> Keep going — you're not there yet!</p>
               <p class="text-slate-200 text-base md:text-lg">You have passed <strong>${passedCount} of ${MODULES.length}</strong> levels. Your work only counts when you pass <strong>all of them</strong>. Repeat the ones marked in red \u2014 you can do it! \ud83d\udcaa</p>
             </div>`;

        container.innerHTML = `
          <div class="grid grid-cols-3 gap-4 items-center bg-slate-950/80 p-5 rounded-2xl border border-slate-800">
            <div class="col-span-2 space-y-1">
              <p class="text-xs text-slate-400 uppercase font-bold tracking-wider">Student</p>
              <h3 class="text-xl md:text-2xl font-black text-white leading-tight">${escapeHtml(currentUser.firstName)} <span class="text-emerald-300">${escapeHtml(currentUser.lastName)}</span></h3>
              <p class="text-sm md:text-base text-emerald-300 font-black">Group: ${escapeHtml(currentUser.grade)}</p>
              <p class="text-xs text-slate-400 font-semibold">${escapeHtml(currentUser.email)}</p>
              <p class="text-xs text-amber-400 font-extrabold mt-1">${currentUser.guest ? "Guest · not sent to any teacher" : "Class code: " + escapeHtml(currentUser.classCode)} · ${nowStr}</p>
            </div>
            <div class="text-center ${allPassed ? "bg-emerald-500/10 border-2 border-emerald-500/40" : "bg-rose-500/10 border-2 border-rose-500/40"} p-4 rounded-2xl">
              <span class="text-xs font-bold ${allPassed ? "text-emerald-400" : "text-rose-400"} block uppercase">Average</span>
              <span class="text-4xl md:text-5xl font-black ${allPassed ? "text-emerald-400" : "text-rose-400"} leading-none">${avg}%</span>
              <span class="block text-[11px] md:text-xs font-black mt-1 ${allPassed ? "text-emerald-300" : "text-rose-300"}">${allPassed ? "✅ PASSED" : "⚠️ NOT PASSED"}</span>
            </div>
          </div>
          ${msg}
          <div>
            <p class="text-xs font-black uppercase text-slate-400 mb-3 tracking-wider">Best score in each module and level</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">${breakdownHtml}</div>
          </div>
          <div class="pt-4 border-t border-slate-800 flex justify-center no-print">
            <button onclick="window.print()" class="px-8 bg-emerald-600 hover:bg-emerald-500 text-white font-black py-4 rounded-2xl transition text-base md:text-lg flex items-center justify-center gap-3"><i class="fa-solid fa-print"></i> Print / Save PDF</button>
          </div>`;
      });
    }
    /* ============================================================
       TEACHER PANEL
       ------------------------------------------------------------
       Cada profesor/a entra con SU PIN (ver window.CLASSES arriba) y
       solo ve los resultados guardados bajo SU codigo de clase.
       ============================================================ */

    let teacherAllRecords = [];
    let teacherSearchTerm = "";
    let teacherRefs = [];
    let teacherRecordsByCode = {};
    let teacherLegacyRecords = [];
    let teacherOpenRows = new Set();
    let currentTeacherScope = [];
    const TEACHER_COLSPAN = 7 + LEVELS.length;

    function openTeacherPanelFor(user) {
      const mine = findTeacher(user && user.email);
      if (!mine) {
        alert("Esta cuenta (" + ((user && user.email) || "?") + ") no es la del profesor.\n\n" +
              "Si eres tu: pon tu correo de Google en TEACHER_EMAIL, dentro del archivo, " +
              "y en reglas-firebase.json.");
        return false;
      }
      currentTeacherScope = [mine];
      currentTeacherLoggedIn = mine.teacher || "Teacher";
      if (quizTimerInterval) clearInterval(quizTimerInterval);
      renderTeacherDashboard();
      showView("viewTeacher");
      return true;
    }

    function showTeacherLogin() {
      if (currentAuthUser && findTeacher(currentAuthUser.email)) {
        openTeacherPanelFor(currentAuthUser);
        return;
      }
      const provider = new firebase.auth.GoogleAuthProvider();
      provider.setCustomParameters({ prompt: "select_account" });
      auth.signInWithPopup(provider).then(res => {
        currentAuthUser = res.user;
        openTeacherPanelFor(res.user);
      }).catch(err => {
        if (err && err.code === "auth/popup-blocked") { auth.signInWithRedirect(provider); return; }
        if (err && (err.code === "auth/popup-closed-by-user" || err.code === "auth/cancelled-popup-request")) return;
        alert("No se pudo entrar: " + ((err && err.message) || err));
      });
    }

    function teacherCodes() { return Object.keys(teacherRecordsByCode).sort(); }

    function isRecord(v) {
      return v && typeof v === "object" && (v.moduleId || v.studentName || v.score !== undefined);
    }

    function detachTeacherRefs() {
      teacherRefs.forEach(r => { try { r.off("value"); } catch (e) {} });
      teacherRefs = [];
    }

    function mergeTeacherRecords() {
      let all = [];
      Object.keys(teacherRecordsByCode).forEach(k => { all = all.concat(teacherRecordsByCode[k]); });
      teacherAllRecords = all.concat(teacherLegacyRecords);
    }

    function readBranch(snapshot, code) {
      const out = [];
      snapshot.forEach(childSnap => {
        const v = childSnap.val();
        if (!v || typeof v !== "object") return;
        if (isRecord(v)) {                       // formato antiguo (sin cuentas)
          out.push(Object.assign({}, v, { classCode: v.classCode || code }));
          return;
        }
        const perfil = v.profile || {};
        const intentos = v.attempts || {};
        Object.keys(intentos).forEach(k => {
          const r = intentos[k];
          if (isRecord(r)) out.push(Object.assign({}, perfil, r, { classCode: r.classCode || code, uid: childSnap.key }));
        });
      });
      return out;
    }

    function renderTeacherDashboard() {
      document.getElementById("teacherTitle").innerText = currentTeacherLoggedIn;
      renderTeacherTableHead();
      teacherSearchTerm = "";
      teacherRecordsByCode = {};
      teacherLegacyRecords = [];
      const searchInput = document.getElementById("teacherSearchInput");
      if (searchInput) searchInput.value = "";
      const tbody = document.getElementById("teacherTableBody");
      tbody.innerHTML = `<tr><td colspan="${TEACHER_COLSPAN}" class="p-6 text-center text-slate-400 font-bold">Loading data from the cloud...</td></tr>`;

      detachTeacherRefs();
      const ref = db.ref(RESULTS_NODE);
      teacherRefs.push(ref);
      ref.on("value", (snapshot) => {
        absorbTeacherSnapshot(snapshot);
        paintTeacherTable();
        updateTeacherLastRefreshed();
      }, (err) => {
        console.error("Error reading Firebase results:", err);
        tbody.innerHTML = `<tr><td colspan="${TEACHER_COLSPAN}" class="p-6 text-center text-rose-400 font-bold">\u26a0\ufe0f Could not load the data (${escapeHtml(err.message)}). Check your connection.</td></tr>`;
      });
    }

    /* El nodo tiene una carpeta por codigo de clase; los codigos se descubren
       leyendo, no hay ninguna lista en esta pagina. */
    function absorbTeacherSnapshot(snapshot) {
      teacherRecordsByCode = {};
      teacherLegacyRecords = [];
      snapshot.forEach(codeSnap => {
        const v = codeSnap.val();
        if (!v || typeof v !== "object") return;
        if (isRecord(v)) { teacherLegacyRecords.push(Object.assign({}, v, { classCode: "\u2014" })); return; }
        teacherRecordsByCode[codeSnap.key] = readBranch(codeSnap, codeSnap.key);
      });
      mergeTeacherRecords();
      const sub = document.getElementById("teacherSubtitle");
      const codes = teacherCodes();
      if (sub) sub.innerHTML = `Class code${codes.length === 1 ? "" : "s"}: <span class="text-amber-300 font-bold">${escapeHtml(codes.join(" \u00b7 ")) || "\u2014"}</span><br>One row per student \u00b7 click a student to see every attempt and every answer they wrote.`;
    }

    function refreshTeacherDashboardNow() {
      const btn = document.getElementById("teacherRefreshBtn");
      if (btn) { btn.disabled = true; btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Refreshing...`; }
      db.ref(RESULTS_NODE).once("value").then(snapshot => {
        absorbTeacherSnapshot(snapshot);
        paintTeacherTable();
        updateTeacherLastRefreshed();
      }).catch(err => {
        alert("Could not refresh: " + err.message);
      }).then(() => {
        if (btn) { btn.disabled = false; btn.innerHTML = `<i class="fa-solid fa-arrows-rotate"></i> Refresh`; }
      });
    }

    function updateTeacherLastRefreshed() {
      const el = document.getElementById("teacherLastRefreshed");
      if (el) el.innerText = `Last updated: ${new Date().toLocaleTimeString("en-GB")}`;
    }

    function renderTeacherTableHead() {
      document.getElementById("teacherTableHead").innerHTML = `
        <tr>
          <th class="p-3">Name</th>
          <th class="p-3">Surname(s)</th>
          <th class="p-3">Group</th>
          <th class="p-3">Code</th>
          ${LEVELS.map(lv => `<th class="p-3 text-center">${lv.tag} \u00b7 ${lv.type === "mcq" ? "choice" : (lv.type === "gap" ? "gaps" : "transl.")}</th>`).join("")}
          <th class="p-3 text-center">Average</th>
          <th class="p-3 text-center">Result</th>
          <th class="p-3">Last activity</th>
        </tr>`;
    }

    function splitName(r) {
      const first = (r.firstName || "").toString().trim();
      const last = (r.lastName || "").toString().trim();
      if (first || last) return { first: first, last: last };
      const parts = (r.studentName || "").toString().trim().split(/\s+/);
      return { first: parts.shift() || "\u2014", last: parts.join(" ") };
    }

    function buildStudentSummaries(records) {
      const byStudent = {};
      records.forEach(r => {
        const n = splitName(r);
        const key = ((r.uid || r.email || (n.first + " " + n.last) || "no_name") + "|" + (r.classCode || "")).toString().trim().toLowerCase();
        if (!byStudent[key]) {
          byStudent[key] = { key, firstName: n.first, lastName: n.last, studentName: r.studentName || (n.first + " " + n.last),
            grade: r.grade || r.group || "\u2014", classCode: r.classCode || "\u2014", email: r.email || "",
            attempts: [], lastTimestamp: 0, lastDateTime: "" };
        }
        const st = byStudent[key];
        st.attempts.push(r);
        const ts = Number(r.timestamp) || 0;
        if (ts >= st.lastTimestamp || !st.lastDateTime) {
          st.lastTimestamp = ts;
          st.lastDateTime = r.dateTime || "";
          if (n.first) st.firstName = n.first;
          if (n.last) st.lastName = n.last;
          st.studentName = (st.firstName + " " + st.lastName).trim();
          if (r.grade || r.group) st.grade = r.grade || r.group;
        }
      });

      return Object.values(byStudent).map(st => {
        const moduleScores = MODULES.map(mod => {
          const list = st.attempts.filter(a => a.moduleId === mod.id);
          return list.length ? Math.max(...list.map(a => Number(a.score) || 0)) : null;
        });
        const moduleAttempts = MODULES.map(mod => st.attempts.filter(a => a.moduleId === mod.id).length);
        const levelStats = LEVELS.map(lv => {
          const idx = MODULES.map((m, i) => i).filter(i => MODULES[i].level === lv.n);
          const got = idx.filter(i => moduleScores[i] !== null);
          const passed = got.filter(i => moduleScores[i] >= passMark(MODULES[i])).length;
          const avg = got.length ? Math.round(got.reduce((a, i) => a + moduleScores[i], 0) / got.length) : null;
          return { done: got.length, total: idx.length, passed: passed, avg: avg };
        });
        const completedCount = moduleScores.filter(sc => sc !== null).length;
        const allDone = completedCount === MODULES.length;
        const allPassed = allDone && moduleScores.every((sc, i) => sc >= passMark(MODULES[i]));
        const finalAverage = allDone ? Math.round(moduleScores.reduce((a, sc) => a + sc, 0) / MODULES.length) : null;
        return Object.assign({}, st, { moduleScores, moduleAttempts, levelStats, completedCount, allDone, allPassed, finalAverage });
      });
    }

    function renderTeacherStats(students) {
      const total = students.length;
      const done = students.filter(s => s.allDone);
      const passed = students.filter(s => s.allPassed).length;
      const avg = done.length ? Math.round(done.reduce((a, s) => a + s.finalAverage, 0) / done.length) : 0;
      document.getElementById("teacherStatsGrid").innerHTML = `
        <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-4 text-center"><div class="text-3xl font-black text-white">${total}</div><div class="text-xs text-slate-400 font-bold uppercase mt-1">Students</div></div>
        <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-4 text-center"><div class="text-3xl font-black text-emerald-400">${done.length}/${total}</div><div class="text-xs text-slate-400 font-bold uppercase mt-1">Did all ${MODULES.length} levels</div></div>
        <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-4 text-center"><div class="text-3xl font-black text-emerald-400">${passed}</div><div class="text-xs text-slate-400 font-bold uppercase mt-1">Passed everything</div></div>
        <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-4 text-center"><div class="text-3xl font-black text-amber-400">${avg}%</div><div class="text-xs text-slate-400 font-bold uppercase mt-1">Group average</div></div>`;
    }

    function filterTeacherTable(term) {
      teacherSearchTerm = term || "";
      paintTeacherTable();
    }

    function visibleStudents() {
      let students = buildStudentSummaries(teacherAllRecords);
      const term = teacherSearchTerm.trim().toLowerCase();
      if (term) {
        students = students.filter(s =>
          (s.firstName || "").toLowerCase().includes(term) ||
          (s.lastName || "").toLowerCase().includes(term) ||
          (s.email || "").toLowerCase().includes(term) ||
          (s.grade || "").toLowerCase().includes(term) ||
          (s.classCode || "").toLowerCase().includes(term));
      }
      students.sort((a, b) =>
        (a.lastName || "").localeCompare(b.lastName || "", "es") ||
        (a.firstName || "").localeCompare(b.firstName || "", "es"));
      return students;
    }

    function toggleStudentDetail(key) {
      if (teacherOpenRows.has(key)) teacherOpenRows.delete(key); else teacherOpenRows.add(key);
      paintTeacherTable();
    }

    function studentDetailHtml(s) {
      const attempts = s.attempts.slice().sort((a, b) => (Number(b.timestamp) || 0) - (Number(a.timestamp) || 0));
      const header = `
        <p class="text-sm md:text-base font-bold text-slate-200 mb-2">
          <i class="fa-solid fa-user text-emerald-400 mr-1"></i> ${escapeHtml(s.firstName)} <span class="text-emerald-300">${escapeHtml(s.lastName)}</span>
          <span class="text-slate-500">\u00b7</span> <span class="text-amber-300">Group: ${escapeHtml(s.grade)}</span>
          <span class="text-slate-500">\u00b7</span> <span class="text-slate-400">${escapeHtml(s.email)}</span>
        </p>`;
      const body = attempts.map(a => {
        const ok = Number(a.score) >= passMarkOf(a.moduleId);
        const answers = Array.isArray(a.answers) ? a.answers : Object.values(a.answers || {});
        const lines = answers.map((x, i) => `
          <div class="grid grid-cols-1 md:grid-cols-3 gap-1 md:gap-3 py-1 border-b border-slate-800/60 text-xs md:text-sm">
            <span class="text-slate-200">${i + 1}. ${escapeHtml(x.prompt || x.text || "")}</span>
            <span class="${x.ok ? "text-emerald-300" : "text-rose-300"} font-mono">${x.ok ? "\u2714" : "\u2718"} ${escapeHtml(x.user) || "\u2014"}</span>
            <span class="text-slate-400 font-mono">${x.ok ? "" : "\u2192 " + escapeHtml(x.correct)}</span>
          </div>`).join("");
        return `
          <details class="bg-slate-950 border ${ok ? "border-emerald-500/30" : "border-rose-500/30"} rounded-xl p-3 mb-2">
            <summary class="cursor-pointer font-bold text-sm md:text-base flex flex-wrap gap-3 items-center">
              <span class="text-white">${escapeHtml(a.topic || a.moduleId)}</span>
              <span class="${ok ? "text-emerald-400" : "text-rose-400"} font-black">${a.score}% (${a.rawScore || ""})</span>
              <span class="text-slate-500 text-xs">${escapeHtml(a.dateTime || "")} \u00b7 ${escapeHtml(a.timeSpent || "")}</span>
            </summary>
            <div class="mt-2">${lines || '<p class="text-slate-500 text-sm">No answer details saved.</p>'}</div>
          </details>`;
      }).join("");
      return header + body;
    }

    function paintTeacherTable() {
      const tbody = document.getElementById("teacherTableBody");
      renderTeacherStats(buildStudentSummaries(teacherAllRecords));
      const students = visibleStudents();

      if (students.length === 0) {
        tbody.innerHTML = `<tr><td colspan="${TEACHER_COLSPAN}" class="p-6 text-center text-slate-500 font-bold">
          ${teacherAllRecords.length === 0 ? "No attempts recorded for your class code yet." : "No student matches your search."}</td></tr>`;
        return;
      }

      tbody.innerHTML = "";
      students.forEach(s => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-slate-800/50 transition cursor-pointer";
        tr.onclick = () => toggleStudentDetail(s.key);

        const moduleCells = s.levelStats.map((st, i) => {
          if (!st.done) return `<td class="p-3 text-center text-slate-600">\u2014</td>`;
          const cls = st.passed === st.total ? "bg-emerald-500/15 text-emerald-400" : (st.avg >= passMark(modulesOfLevel(i + 1)[0]) ? "bg-amber-500/15 text-amber-300" : "bg-rose-500/15 text-rose-400");
          return `<td class="p-3 text-center"><span class="inline-block px-2 py-1 rounded-lg font-black text-xs ${cls}">${st.passed}/${st.total}</span><span class="block text-[10px] text-slate-500 mt-1">avg ${st.avg}%</span></td>`;
        }).join("");

        const avgCell = s.allDone
          ? `<span class="font-black text-white">${s.finalAverage}%</span>`
          : `<span class="font-bold text-slate-400">${s.completedCount}/${MODULES.length}</span>`;
        const resultCell = !s.allDone
          ? `<span class="text-xs font-bold text-slate-500">In progress</span>`
          : (s.allPassed ? `<span class="text-xs font-black text-emerald-400">\u2705 Passed</span>` : `<span class="text-xs font-black text-rose-400">\u26a0\ufe0f Not passed</span>`);
        const open = teacherOpenRows.has(s.key);

        tr.innerHTML = `
          <td class="p-3 font-extrabold text-white"><i class="fa-solid ${open ? "fa-chevron-down" : "fa-chevron-right"} text-slate-500 text-xs mr-1"></i>${escapeHtml(s.firstName)}</td>
          <td class="p-3 font-extrabold text-emerald-300">${escapeHtml(s.lastName)}<span class="block text-[11px] text-slate-500 font-medium">${escapeHtml(s.email)}</span></td>
          <td class="p-3 text-slate-300 font-bold">${escapeHtml(s.grade || "\u2014")}</td>
          <td class="p-3 text-amber-300/80 font-mono text-xs">${escapeHtml(s.classCode || "\u2014")}</td>
          ${moduleCells}
          <td class="p-3 text-center">${avgCell}</td>
          <td class="p-3 text-center">${resultCell}</td>
          <td class="p-3 text-slate-400 text-xs">${escapeHtml(s.lastDateTime || "\u2014")}</td>`;
        tbody.appendChild(tr);

        if (open) {
          const dr = document.createElement("tr");
          dr.innerHTML = `<td colspan="${TEACHER_COLSPAN}" class="p-3 md:p-4 bg-slate-900/60">${studentDetailHtml(s)}</td>`;
          tbody.appendChild(dr);
        }
      });
    }

    function exportTeacherCsv() {
      const students = visibleStudents();
      const esc = v => `"${(v === null || v === undefined ? "" : String(v)).replace(/"/g, '""')}"`;
      const header = ["Name", "Surname(s)", "Group", "Class code", "Email",
        ...MODULES.map(m => m.short + " (best %)"), ...MODULES.map(m => m.short + " (attempts)"),
        "Average %", "Result", "Last activity"];
      const rows = students.map(s => [
        s.firstName, s.lastName, s.grade, s.classCode, s.email,
        ...s.moduleScores.map(v => v === null ? "" : v),
        ...s.moduleAttempts,
        s.allDone ? s.finalAverage : "",
        !s.allDone ? "In progress" : (s.allPassed ? "Passed" : "Not passed"),
        s.lastDateTime
      ]);
      const csv = "\ufeff" + [header, ...rows].map(r => r.map(esc).join(";")).join("\r\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `modal_verbs_${teacherCodes().join("_")}_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }


    window.onload = initApp;
  </script>
</body>
