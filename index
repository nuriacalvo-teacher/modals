        for (let i = 0; i < toks.length; i++) {
          const t = toks[i], prev = out[out.length - 1];
          const isNum = prev !== undefined && /^\d+$/.test(prev);
          if (isNum && (t === "am" || t === "pm")) continue;                                  // 7 am = 7
          if (isNum && (t === "a" || t === "p") && toks[i + 1] === "m") { i++; continue; }    // 7 a.m. = 7
