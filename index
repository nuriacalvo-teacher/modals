      // Lecturas posibles de una ficha escrita por el ALUMNO
      function studentReadings(t, next) {
        let r;
        if (t.indexOf("'") >= 0) r = aposReadings(t, true);
        else if (NOAPOS[t]) r = NOAPOS[t];
