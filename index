        function seq(stops) {
          const parts = []; let lit = "";
          const flush = () => { if (lit) { parts.push({ t: "lit", v: lit }); lit = ""; } };
          while (i < src.length) {
            const c = src[i];
            if (stops.indexOf(c) >= 0) break;
            if (c === "(" || c === "[") {
              flush(); i++;
              const close = c === "(" ? ")" : "]";
              const opts = [seq("|" + close)];
              while (src[i] === "|") { i++; opts.push(seq("|" + close)); }
              if (src[i] !== close) throw new Error("L3 pattern: falta '" + close + "' en: " + src);
