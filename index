      GLOSS_KEYS.forEach(k => {
        const kk = stripAccents(k.toLowerCase());
        const pos = low.indexOf(kk);
        if (pos < 0) return;
        const before = pos === 0 ? " " : low[pos - 1];
        const after = (pos + kk.length >= low.length) ? " " : low[pos + kk.length];
