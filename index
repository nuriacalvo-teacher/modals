    function paintModulesGrid(scoresByModule) {
      const grid = document.getElementById("modulesGrid");
      grid.innerHTML = "";
      LEVELS.forEach(lv => {
        const mods = modulesOfLevel(lv.n);
        const passed = mods.filter(m => {
          const sc = scoresByModule ? scoresByModule[m.id] : null;
          return sc !== null && sc !== undefined && sc >= passMark(m);
        }).length;
        const section = document.createElement("section");
        section.className = "space-y-5";
        section.innerHTML = `
          <div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-slate-800 pb-3">
