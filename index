        const inner = section.querySelector("div.grid");
        mods.forEach(mod => {
          const best = scoresByModule ? scoresByModule[mod.id] : null;
          inner.appendChild(buildModuleCard(mod, best === undefined ? null : best));
        });
        grid.appendChild(section);
      });
    }

    function renderModules() {
      paintModulesGrid(null);
      fetchMyRecords((scores) => {
        const best = {};
        MODULES.forEach(mod => {
          const userScores = scores.filter(s => s && s.moduleId === mod.id);
          best[mod.id] = userScores.length > 0 ? Math.max(...userScores.map(s => Number(s.score) || 0)) : null;
        });
        paintModulesGrid(best);
      });
    }

