        (q.answers || []).concat(q.alts || []).forEach(add);
        if (st.over) console.warn("[L3] " + (q.qid || "?") + ": more than " + MAX_VARIANTS + " variants; list truncated. Simplify its pattern.");
        const trie = new Map();
        set.forEach(s => {
